<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SAM_UI_Avalonia.ViewModels"
        xmlns:views="using:SAM_UI_Avalonia.Views"
        xmlns:ctrl="using:SAM_UI_Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SAM_UI_Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/chip.ico"
        Width="800" Height="630"
        MinWidth="400" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SamWindowBackground}"
        Title="SAM_UI_Avalonia">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="100,Auto,*,Auto" ColumnDefinitions="270,*">

                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="4"
                Background="{DynamicResource SamSidebarBackground}"
                BorderBrush="{DynamicResource SamDividerBrush}"
                BorderThickness="0,0,1,0"/>

        <Image Grid.Row="0" Source="/Assets/title.png" Stretch="Uniform"/>

        <StackPanel Grid.Row="1" Margin="10,0,10,0">
            <Grid ColumnDefinitions="71,*" VerticalAlignment="Top">
                <Border x:Name="DropTarget" BorderBrush="{DynamicResource SamDropBorderBrush}" Background="Transparent" BorderThickness="1" Width="70" Height="70"
                        VerticalAlignment="Top" DragDrop.AllowDrop="True">
                    <ctrl:BusySpinner Width="66" Height="66"
                                      Foreground="{DynamicResource SamDropBorderBrush}"
                                      IsBusy="{Binding IsSpinning}"
                                      IsVisible="{Binding IsRunning}"
                                      IsHitTestVisible="False"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,10,0,0">
                    <TextBlock Text="&lt;-- drop Files / Dirs here"/>  
                        <Button Content="{Binding PauseButtonText}" Width="170" Command="{Binding PauseCommand}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>                      
                    <StackPanel Orientation="Horizontal" Margin="0,2,2,0">
                        <Button Content="Soft Stop" Width="85" Command="{Binding SoftStopCommand}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Content="Hard Stop" Width="85" Command="{Binding HardStopCommand}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>           
                </StackPanel>
            </Grid>
            
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">   
                <TextBlock Text="Input:" Width="68" VerticalAlignment="Center" />
				<ComboBox Width="182"
						  ItemsSource="{Binding InputTypes}"
						  SelectedValue="{Binding SelectedInputType}"
						  SelectedValueBinding="{Binding Value}"
						  DisplayMemberBinding="{Binding Display}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">   
                <TextBlock Text="Output:"  Width="68" VerticalAlignment="Center" />  
				<ComboBox Width="182"
						  ItemsSource="{Binding OutputTypes}"
						  SelectedValue="{Binding SelectedOutputType}"
						  SelectedValueBinding="{Binding Value}"
						  DisplayMemberBinding="{Binding Display}"/>
            </StackPanel>
            <CheckBox Content="Dry Run" FlowDirection="RightToLeft" HorizontalAlignment="Right" IsChecked="{Binding IsDryRun}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ProgressText}"/>
                <TextBlock Text="{Binding StateText}" Margin="10,0,0,0"/>
            </StackPanel>
            <Grid ColumnDefinitions="*,25">
                <Slider Grid.Column="0" Minimum="1" Maximum="{Binding MaxThreadCount}" TickFrequency="1" VerticalAlignment="Center" IsSnapToTickEnabled="True" Value="{Binding ThreadCount}"/>
                <TextBlock Grid.Column="1" Text="{Binding ThreadCount}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="7,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ProcessStats}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:procStatus">
                        <views:ProcessStatus/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
               
        <TextBlock Grid.Row="3" Text="www.romvault.com" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemAccentColor}"
                   TextDecorations="Underline"
                   Cursor="Hand"
                   ToolTip.Tip="https://www.romvault.com"
                   PointerPressed="OnRomVaultLinkPressed"/>

        <DataGrid x:Name="FilesGrid" Grid.Row="0" Grid.Column="1" Grid.RowSpan="4" ItemsSource="{Binding Files}"
                  Background="{DynamicResource SamWindowBackground}"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeight="20"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Styles>
                <Style Selector="DataGridRow">
                    <Setter Property="Focusable" Value="False"/>
                </Style>
                <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                    <Setter Property="Opacity" Value="0"/>
                </Style>
                <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
                    <Setter Property="Opacity" Value="0"/>
                </Style>
                <Style Selector="DataGridCell">
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Focusable" Value="False"/>
                </Style>
                <Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
                    <Setter Property="IsVisible" Value="False"/>
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Filename" Width="*" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:samFile">
                            <ctrl:PathTextBlock Text="{Binding Name}"
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{Binding Name}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Size" Width="100" MinWidth="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:samFile">
                            <TextBlock Text="{Binding SizeText}"
                                                FontSize="12"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Status" Width="150" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:samFile">
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- While processing: progress bar + percentage. -->
                                <ProgressBar Grid.Column="0"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding Progress}"
                                             IsVisible="{Binding IsProcessing}"
                                             Height="10" MinHeight="0" MinWidth="0"
                                             VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProgressText}"
                                           IsVisible="{Binding IsProcessing}"
                                           FontSize="12"
                                           MinWidth="36"
                                           TextAlignment="Right"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                                <!-- When finished: the result text. -->
                                <TextBlock Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Status}"
                                           IsVisible="{Binding IsNotProcessing}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding Status}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</Window>

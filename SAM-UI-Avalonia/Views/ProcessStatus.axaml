<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SAM_UI_Avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="50"
             x:DataType="vm:procStatis"
             x:Class="SAM_UI_Avalonia.Views.ProcessStatus">

    <StackPanel Margin="0,0,0,6">
        <TextBlock Text="{Binding Name}"/>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="20" Margin="0,3,8,0"/>
    </StackPanel>

</UserControl>
